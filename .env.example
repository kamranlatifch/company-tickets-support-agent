# Copy this file to .env and fill in real values. Never commit .env.

# LLM + embeddings via OpenRouter — same key pattern as the Week1-4 training repo
# and role-rag-app. Note the exact spelling: OPRN, not OPEN.
COGENT_OPRNROUTER_KEY=sk-or-v1-your-key-here
GEMINI_MODEL=google/gemini-2.5-flash
EMBED_MODEL=openai/text-embedding-3-small

# Turso (ticket + account storage). Create a free database at
# https://turso.tech — `turso db create cogent-support` then
# `turso db show cogent-support --url` and `turso db tokens create cogent-support`.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Brevo (email on ticket resolution). Free tier: 300 emails/day. A Gmail sender works
# with no DNS setup (Brevo sends from its own domain); verify the sender under
# Senders, Domains & Dedicated IPs. BREVO_API_KEY must be an API key (starts with
# xkeysib-) from SMTP & API > API Keys, NOT an SMTP key (xsmtpsib-). Leave it blank
# and emails are only logged, not sent.
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_FROM_EMAIL=your-verified-sender@example.com
BREVO_FROM_NAME=Cogent Support

# Logfire tracing (optional) — blank = nothing is sent anywhere. See support_chat/observability.py
LOGFIRE_TOKEN=

# Evals: the LLM that grades answers (default anthropic/claude-haiku-4.5). See docs/EVALS.md
# EVAL_JUDGE_MODEL=anthropic/claude-haiku-4.5

# Ticket policy
REFUND_APPROVAL_THRESHOLD_USD=50
MAX_TICKETS_PER_LOGIN=2
